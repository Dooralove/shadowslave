# Godot: generated cache and editor state
.godot/
*.translation
export_presets.cfg

# Godot MCP scratch space (undo snapshots, screenshots), as in upstream .gitignore.
# Keep only the .gdignore that stops the editor importing snapshot copies (duplicate UIDs).
addons/godot_mcp/cache/*
!addons/godot_mcp/cache/undo/
addons/godot_mcp/cache/undo/*
!addons/godot_mcp/cache/undo/.gdignore

# Local Claude Code settings (per-machine)
.claude/settings.local.json

# Secrets and local environment
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Python bytecode from Blender build scripts
__pycache__/
*.pyc

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
tmp/
temp/

# Installers, archives and engine binaries kept outside the repo
*.exe
*.msi
*.zip
*.7z

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Material Maker + MaterialPilot pilot (isolated, not committed)
/experiments/

# Godot: generated cache and editor state
.godot/
*.translation
export_presets.cfg

# Godot MCP scratch space (undo snapshots, screenshots), as in upstream .gitignore.
# Keep only the .gdignore that stops the editor importing snapshot copies (duplicate UIDs).
addons/godot_mcp/cache/*
!addons/godot_mcp/cache/undo/
addons/godot_mcp/cache/undo/*
!addons/godot_mcp/cache/undo/.gdignore

# Local Claude Code settings (per-machine)
.claude/settings.local.json

# Secrets and local environment
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Python bytecode from Blender build scripts
__pycache__/
*.pyc

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
tmp/
temp/

# Installers, archives and engine binaries kept outside the repo
*.exe
*.msi
*.zip
*.7z

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Material Maker + MaterialPilot pilot (isolated, not committed)
/experiments/

# Hyper3D web UI staging: raw GLB/concepts, imported only after review
/incoming_models/

# Godot extracts embedded glTF images next to the source file.
# Regenerate from the .glb instead of committing these derived files.
assets/environments/nightmare/statue/statue_knight_colossus_*.jpg
assets/environments/nightmare/statue/statue_knight_colossus_*.png
assets/environments/nightmare/statue/statue_knight_colossus_*.jpg.import
assets/environments/nightmare/statue/statue_knight_colossus_*.png.import
assets/environments/nightmare/statue/stone_knight_source_*

# Godot extracts embedded glTF images next to generated character GLBs.
# Regenerate from the .glb instead of committing these derived files.
assets/characters/generated/**/*_texture_*.png
assets/characters/generated/**/*_texture_*.png.import

# Local release artifacts: rebuild with export_presets.cfg; never commit.
/build/

checkpoint_id = &"CP-N10a"
checkpoint_ids = Array[StringName]([&"CP-N10a", &"CP-N10b"])
checkpoint_positions = Dictionary[StringName, Vector3]({
&"CP-N10a": Vector3(0.6, 0.05, 2.1),
&"CP-N10b": Vector3(-2.6, 0.05, -2.0)
})
entry_conditions = Array[StringName]([&"chains_released"])
exit_conditions = Array[StringName]([&"wagon_fall_seen", &"tyrant_fall_seen"])
staging_flags = Array[StringName]([&"tyrant_alive_suspected"])

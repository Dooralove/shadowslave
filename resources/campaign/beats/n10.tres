[gd_resource type="Resource" script_class="BeatData" format=3]

[ext_resource type="Script" path="res://scripts/campaign/beat_data.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
id = &"N10"
part = &"act_1"
part_title = "Акт I «Цепь»"
canonical_block = 9
title = "Ловушка с повозкой"
beat_type = 0
format_label = "И + К"
objective = "Сбросить Тирана с обрыва"

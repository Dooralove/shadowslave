[resource]
script = ExtResource("2_def")
id = &"black_sea_platform"
title = "ШЕЯ БЕЗГОЛОВОГО РЫЦАРЯ"
subtitle = "Чёрное море · платформа-шея"
description = "Круглая каменная площадка около 12 м в диаметре — срез шеи колоссальной статуи рыцаря. Голова отсутствует; на нагруднике семь звёзд, меч опущен к земле. Вокруг только чёрная вода без луны и звёзд."
background_color = Color(0.012, 0.02, 0.032, 1)
land_color = Color(0.21, 0.23, 0.26, 1)
accent_color = Color(0.48, 0.64, 0.86, 1)
terrain_style = &"stone"
world_bounds = Rect2(-42, -62, 84, 88)
features = Array[ExtResource("3_feature")]([SubResource("Feature_0"), SubResource("Feature_1"), SubResource("Feature_2"), SubResource("Feature_3"), SubResource("Feature_4"), SubResource("Feature_5"), SubResource("Feature_6"), SubResource("Feature_7")])
markers = Array[ExtResource("1_marker")]([SubResource("Marker_0"), SubResource("Marker_1"), SubResource("Marker_2"), SubResource("Marker_3"), SubResource("Marker_4"), SubResource("Marker_5"), SubResource("Marker_6"), SubResource("Marker_7")])
scene_paths = PackedStringArray("res://scenes/locations/post_nightmare/black_sea_platform.tscn")

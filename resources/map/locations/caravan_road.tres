kind = 2

[resource]
script = ExtResource("2_def")
id = &"caravan_road"
title = "КАРАВАННЫЙ ПЕРЕВАЛ"
subtitle = "Горная дорога Первого Кошмара"
description = "Прямой участок перевала: дорога идёт вдоль скальной стены, с западной стороны ограничена барьером над обрывом. Переход к стоянке — в конце видимой части дороги; дальше путь показан пунктиром."
background_color = Color(0.06, 0.072, 0.085, 1)
land_color = Color(0.235, 0.24, 0.225, 1)
accent_color = Color(0.64, 0.58, 0.42, 1)
terrain_style = &"snow"
world_bounds = Rect2(-12, -48, 20, 88)
features = Array[ExtResource("3_feature")]([SubResource("Feature_0"), SubResource("Feature_1"), SubResource("Feature_2"), SubResource("Feature_3"), SubResource("Feature_4")])
markers = Array[ExtResource("1_marker")]([SubResource("Marker_0"), SubResource("Marker_1")])
scene_paths = PackedStringArray("res://scenes/slice/locations/caravan_road.tscn", "res://scenes/slice/locations/caravan_road_art.tscn", "res://scenes/campaign/first_nightmare_pass.tscn")
world_rect = Rect2(0.34, 0.2, 0.2, 0.14)

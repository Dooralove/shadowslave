[resource]
script = ExtResource("2_def")
id = &"caravan_site"
title = "СТОЯНКА КАРАВАНА"
subtitle = "Костёр, повозка и обрыв"
description = "Стоянка у подножия скалы. Единственный выход — южный проход к точке «Начать восхождение». Северный проход перекрыт барьером, западный край обрывается в долину."
background_color = Color(0.062, 0.065, 0.075, 1)
land_color = Color(0.245, 0.23, 0.195, 1)
accent_color = Color(0.72, 0.55, 0.31, 1)
terrain_style = &"snow"
world_bounds = Rect2(-8.5, -8, 17, 18)
features = Array[ExtResource("3_feature")]([SubResource("Feature_0"), SubResource("Feature_1"), SubResource("Feature_2"), SubResource("Feature_3"), SubResource("Feature_4"), SubResource("Feature_5"), SubResource("Feature_6"), SubResource("Feature_7"), SubResource("Feature_8"), SubResource("Feature_9"), SubResource("Feature_10"), SubResource("Feature_11"), SubResource("Feature_12"), SubResource("Feature_13"), SubResource("Feature_14")])
markers = Array[ExtResource("1_marker")]([SubResource("Marker_0"), SubResource("Marker_1"), SubResource("Marker_2"), SubResource("Marker_3"), SubResource("Marker_4"), SubResource("Marker_5"), SubResource("Marker_6")])
scene_paths = PackedStringArray("res://scenes/locations/caravan_site/caravan_site.tscn", "res://scenes/locations/caravan_site/caravan_site_art.tscn", "res://scenes/campaign/caravan_site_arrival.tscn")
world_rect = Rect2(0.34, 0.37, 0.19, 0.13)

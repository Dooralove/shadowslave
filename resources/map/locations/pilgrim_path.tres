[resource]
script = ExtResource("2_def")
id = &"pilgrim_path"
title = "ТРОПА ПАЛОМНИКОВ"
subtitle = "Скалы, пещера и путь к храму"
description = "Подъём к храму по узкой тропе. От стартовой площадки путь обходит разрыв дороги по восточному пандусу, затем идёт по уступам вверх, через альков и пещеру, к вратам храма."
background_color = Color(0.052, 0.065, 0.078, 1)
land_color = Color(0.215, 0.235, 0.22, 1)
accent_color = Color(0.62, 0.6, 0.44, 1)
terrain_style = &"snow"
world_bounds = Rect2(-12, -90, 24, 102)
features = Array[ExtResource("3_feature")]([SubResource("Feature_0"), SubResource("Feature_1"), SubResource("Feature_2"), SubResource("Feature_3"), SubResource("Feature_4"), SubResource("Feature_5"), SubResource("Feature_6"), SubResource("Feature_7"), SubResource("Feature_8"), SubResource("Feature_9"), SubResource("Feature_10"), SubResource("Feature_11"), SubResource("Feature_12"), SubResource("Feature_13"), SubResource("Feature_14"), SubResource("Feature_15"), SubResource("Feature_16"), SubResource("Feature_17"), SubResource("Feature_18")])
markers = Array[ExtResource("1_marker")]([SubResource("Marker_0"), SubResource("Marker_1"), SubResource("Marker_2"), SubResource("Marker_3"), SubResource("Marker_4"), SubResource("Marker_5"), SubResource("Marker_6")])
scene_paths = PackedStringArray("res://scenes/locations/pilgrim_path/pilgrim_path.tscn", "res://scenes/locations/pilgrim_path/pilgrim_path_art.tscn", "res://scenes/campaign/pilgrim_path_arrival.tscn")
world_rect = Rect2(0.53, 0.38, 0.2, 0.14)

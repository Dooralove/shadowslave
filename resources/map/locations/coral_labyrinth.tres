[resource]
script = ExtResource("2_def")
id = &"coral_labyrinth"
title = "КОРАЛЛОВЫЙ ЛАБИРИНТ"
subtitle = "Гроты, кости и святилище"
description = "Прототип подводного лабиринта: верхняя площадка у лестницы, коралловые стены, развилка, восточный и западный гроты, потайная камера и святилище со звездой."
background_color = Color(0.045, 0.025, 0.035, 1)
land_color = Color(0.24, 0.13, 0.14, 1)
accent_color = Color(0.85, 0.42, 0.4, 1)
terrain_style = &"stone"
world_bounds = Rect2(-20, -31, 40, 62)
features = Array[ExtResource("3_feature")]([SubResource("Feature_0"), SubResource("Feature_1"), SubResource("Feature_2"), SubResource("Feature_3"), SubResource("Feature_4"), SubResource("Feature_5"), SubResource("Feature_6"), SubResource("Feature_7"), SubResource("Feature_8"), SubResource("Feature_9"), SubResource("Feature_10"), SubResource("Feature_11"), SubResource("Feature_12"), SubResource("Feature_13"), SubResource("Feature_14")])
markers = Array[ExtResource("1_marker")]([SubResource("Marker_0"), SubResource("Marker_1"), SubResource("Marker_2"), SubResource("Marker_3"), SubResource("Marker_4"), SubResource("Marker_5"), SubResource("Marker_6"), SubResource("Marker_7")])
scene_paths = PackedStringArray("res://scenes/locations/post_nightmare/coral_labyrinth.tscn")

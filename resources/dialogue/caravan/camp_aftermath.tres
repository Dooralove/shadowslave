[gd_resource type="Resource" script_class="DialogueSequence" format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_sequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2_line")
speaker = &"hero"
text = "Считаем. Я, ты, Шифти, Учёный. Больше никого."
duration = 3.0

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2_line")
speaker = &"shifty"
text = "Все остальные... там, внизу?"
duration = 2.4

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2_line")
speaker = &"hero"
text = "На рассвете идём вниз. Перевал долгий, припасов нет."
duration = 3.2

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("2_line")
speaker = &"shifty"
text = "Вниз? Снова в цепи? Нет."
duration = 2.6

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("2_line")
speaker = &"scholar"
text = "Внизу — империя. Наверху — только холод."
duration = 2.8

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("2_line")
speaker = &"sunny"
text = "Тиран пережил падение с неба. Обрыв мог его не убить. Внизу он может ждать."
duration = 4.0

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Заклятие не подтвердило смерть. Санни не говорит этого вслух."
duration = 3.2

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("2_line")
speaker = &"hero"
text = "Значит, вверх. До рассвета соберём припасы."
duration = 2.8

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("2_line")
speaker = &"hero"
text = "Я — волы. Учёный — дрова. Шифти — тёплая одежда. Санни — фляги."
duration = 3.8

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("2_line")
speaker = &"shifty"
text = "Почему всегда я..."
duration = 2.2

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("2_line")
speaker = &"hero"
text = "Потому что ты ещё можешь идти."
duration = 2.6

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Никто не спорит. Это не доверие, а перемирие."
duration = 3.0

[resource]
script = ExtResource("1_seq")
lines = [SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6"), SubResource("Line_7"), SubResource("Line_8"), SubResource("Line_9"), SubResource("Line_10"), SubResource("Line_11"), SubResource("Line_12")]

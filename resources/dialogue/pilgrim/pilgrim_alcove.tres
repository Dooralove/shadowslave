[gd_resource type="Resource" script_class="DialogueSequence" format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_sequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2_line")
speaker = &"narration"
text = "За узким выступом — альков. Ветер здесь слабее."
duration = 3.0

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2_line")
speaker = &"hero"
text = "Разводите огонь. Я на первую стражу."
duration = 2.8

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2_line")
speaker = &"shifty"
text = "Вода... у кого вода?"
duration = 2.0

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("2_line")
speaker = &"hero"
text = "Общие фляги. Свою Санни не отдаёт."
duration = 1.8

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Шифти пьёт из общей фляги, до дна. Герой молчит."
duration = 2.4

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Ночь. Никто не спит."
duration = 2.2

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Внизу, под обрывом, что-то движется."
duration = 2.8

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Пять слепых глаз. Тиран ест мёртвых."
duration = 3.4

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("2_line")
speaker = &"shifty"
text = "Санни... там..."
duration = 1.8

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Камень срывается из-под ноги. Тиран поднимает голову."
duration = 3.0

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Он смотрит прямо на Санни — и не видит."
duration = 3.0

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("2_line")
speaker = &"sunny"
text = "Он слеп."
duration = 1.8

[resource]
script = ExtResource("1_seq")
lines = [SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6"), SubResource("Line_7"), SubResource("Line_8"), SubResource("Line_9"), SubResource("Line_10"), SubResource("Line_11"), SubResource("Line_12")]

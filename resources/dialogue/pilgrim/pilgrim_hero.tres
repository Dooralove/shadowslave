[gd_resource type="Resource" script_class="DialogueSequence" format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_sequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Старая тропа над облаками. Санни выходит из щели."
duration = 3.0

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2_line")
speaker = &"hero"
text = "Стой."
duration = 1.2

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Санни поднимает руки. В левом боку — кровь."
duration = 2.6

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("2_line")
speaker = &"hero"
text = "Я должен был идти вниз. Ты был прав."
duration = 2.8

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("2_line")
speaker = &"sunny"
text = "Ты обещал, что я не умру."
duration = 2.4

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("2_line")
speaker = &"hero"
text = "Я сделаю быстро. Последние слова?"
duration = 2.6

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Санни молчит."
duration = 1.8

[resource]
script = ExtResource("1_seq")
lines = [SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6"), SubResource("Line_7")]

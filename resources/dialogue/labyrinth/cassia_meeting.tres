[gd_resource type="Resource" script_class="DialogueSequence" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2_line")
speaker = &"cassia"
text = "Ты не похож на тех, кто приходит сюда за славой."
duration = 0.0

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2_line")
speaker = &"sunny"
text = "Я пришёл, потому что не было выбора."
duration = 0.0

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2_line")
speaker = &"cassia"
text = "Тогда держись ближе к огню. Здесь выбор хотя бы есть."
duration = 0.0

[resource]
script = ExtResource("1_sequence")
lines = [SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")]

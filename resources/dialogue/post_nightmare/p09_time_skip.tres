[gd_resource type="Resource" script_class="DialogueSequence" format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_sequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2_line")
speaker = &"narration"
text = "МЕСЯЦ В АКАДЕМИИ"
duration = 0.0

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Лекции. Тренировки. Разговоры, которые он старался не запоминать."
duration = 0.0

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Кассия. Слепая девушка, которая всегда знала, где он стоит."
duration = 0.0

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Нефис. Серебряные волосы. Она не задавала лишних вопросов."
duration = 0.0

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("2_line")
speaker = &"narration"
text = "Потом пришёл день капсулы."
duration = 0.0

[resource]
script = ExtResource("1_seq")
lines = [SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4"), SubResource("Line_5")]

[gd_resource type="Resource" script_class="ArmorStats" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/equipment/armor_stats.gd" id="1_stats"]
[ext_resource type="Script" path="res://scripts/stats/stat_modifier.gd" id="2_modifier"]

[sub_resource type="Resource" id="StatModifier_heavy_vitals"]
script = ExtResource("2_modifier")
stat = &"max_health"
operation = 0
value = 15.0
label = "+15 к запасу здоровья"
description = "Полный латный доспех превращает тело в крепость."

[sub_resource type="Resource" id="StatModifier_heavy_stagger"]
script = ExtResource("2_modifier")
stat = &"stagger_resistance"
operation = 0
value = 0.05
label = "+5% к стойкости"
description = "Тяжёлые пластины гасят остаточный импульс."

[sub_resource type="Resource" id="StatModifier_heavy_speed"]
script = ExtResource("2_modifier")
stat = &"move_speed"
operation = 2
value = 0.86
label = "x0.86 к скорости"
description = "Латы требуют широкого шага и разгона."

[sub_resource type="Resource" id="StatModifier_heavy_stamina"]
script = ExtResource("2_modifier")
stat = &"stamina_regen"
operation = 2
value = 0.85
label = "x0.85 к выносливости"
description = "Каждый шаг в латах стоит дороже."

[resource]
script = ExtResource("1_stats")

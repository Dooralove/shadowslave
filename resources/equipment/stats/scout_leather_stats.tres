[gd_resource type="Resource" script_class="ArmorStats" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/equipment/armor_stats.gd" id="1_stats"]
[ext_resource type="Script" path="res://scripts/stats/stat_modifier.gd" id="2_modifier"]

[sub_resource type="Resource" id="StatModifier_scout_speed"]
script = ExtResource("2_modifier")
stat = &"move_speed"
operation = 0
value = 0.04
label = "+4% к скорости"
description = "Лёгкий кожаный доспех почти не стесняет движений."

[sub_resource type="Resource" id="StatModifier_scout_stamina"]
script = ExtResource("2_modifier")
stat = &"stamina_regen"
operation = 0
value = 0.08
label = "+8% к восстановлению выносливости"
description = "Разведчик дышит ровно даже в долгом переходе."

[sub_resource type="Resource" id="StatModifier_scout_vitals"]
script = ExtResource("2_modifier")
stat = &"max_health"
operation = 0
value = -5.0
label = "-5 к запасу здоровья"
description = "Кожа держит порез, но не спасает от тяжёлого удара."

[resource]
script = ExtResource("1_stats")

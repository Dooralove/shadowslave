display_name = "Кольцо с тусклым камнем"
category = 1
rarity = 2
icon = ExtResource("11_ring")
description = "Простое кольцо с матовым камнем. Нужно для проверки слота аксессуара и визуального акцента редкости."
flavor = "Камень почти не отражает свет. Демонстрационный предмет."

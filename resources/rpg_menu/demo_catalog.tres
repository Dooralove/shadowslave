[sub_resource type="Resource" id="Item_blade"]
script = ExtResource("2_item")
id = &"demo_training_blade"
display_name = "Учебный клинок"
category = 0
rarity = 0
icon = ExtResource("6_sword")
description = "Тупой тренировочный клинок без клейма. Демонстрационный предмет для проверки сетки, карточки и кнопок экипировки."
flavor = "На гарде процарапан условный знак учебной площадки. К канону не относится."
quantity = 1
weight = 1.1
equipped = true
equip_slot = &"weapon"
stats = [SubResource("Stat_blade_damage"), SubResource("Stat_blade_weight")]
properties = PackedStringArray("Демонстрационное оружие", "Экипировано в тестовом наборе")
demo_price = 12

[sub_resource type="Resource" id="Item_dagger"]
script = ExtResource("2_item")
id = &"demo_nameless_dagger"
display_name = "Кинжал без имени"
category = 0
rarity = 2
icon = ExtResource("7_dagger")
description = "Короткий кинжал с матовым лезвием. Придуман только для демонстрации редкости и недоступных действий."
flavor = "На клинке нет ни имени мастера, ни владельца. Демонстрационный образец."
quantity = 1
weight = 0.7
is_new = true
equip_slot = &"weapon"
stats = [SubResource("Stat_dagger_damage"), SubResource("Stat_dagger_weight")]
properties = PackedStringArray("Демонстрационная редкость", "Не является каноничным предметом")
demo_price = 28

[sub_resource type="Resource" id="Item_jacket"]
script = ExtResource("2_item")
id = &"demo_quilted_jacket"
display_name = "Стёганая куртка"
category = 1
rarity = 1
icon = ExtResource("8_armor")
description = "Плотная стёганая куртка с грубой прострочкой. Тестовый предмет экипировки, не связанный с гардеробом Санни."
flavor = "Внутренний карман пуст. Все характеристики условны."
quantity = 1
weight = 2.8
equipped = true
equip_slot = &"chest"
stats = [SubResource("Stat_armor_guard"), SubResource("Stat_armor_weight")]
properties = PackedStringArray("Демонстрационная экипировка", "Занимает слот «Доспех»")
demo_price = 20

[sub_resource type="Resource" id="Item_cloak"]
script = ExtResource("2_item")
id = &"demo_road_cloak"
display_name = "Дорожный плащ"
category = 1
rarity = 0
icon = ExtResource("9_cloak")
description = "Выцветший дорожный плащ из плотной ткани. Служит примером предмета, который можно экипировать или продать только в демо-витрине."
flavor = "Край подола обтрёпан дальней дорогой. Демонстрационный предмет."
quantity = 1
weight = 1.4
equip_slot = &"cloak"
stats = [SubResource("Stat_cloak_guard"), SubResource("Stat_cloak_weight")]
properties = PackedStringArray("Демонстрационная экипировка", "Слот «Плащ»")
demo_price = 14


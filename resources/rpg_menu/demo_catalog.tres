id = &"demo_pale_herb_draught"
display_name = "Отвар из бледных трав"
category = 2
rarity = 1
icon = ExtResource("12_potion")
description = "Мутный отвар с травяным запахом. Демонстрационный расходник: кнопка «Использовать» уменьшает количество, но не влияет на игру."
flavor = "Осадок оседает на дне медленно, как пепел. Демонстрационный предмет."

[resource]
script = ExtResource("1_catalog")
catalog_note = "Демонстрационные данные интерфейса. Не канон, не сохранения, не игровая экономика."
character_name = "Санни"
status_sheet = ExtResource("5_status")
character_note = "Идентификаторы персонажа взяты из существующего StatusSheet. Числовые показатели и экипировка ниже — только тестовые данные интерфейса."
demo_stats = [SubResource("Stat_strength"), SubResource("Stat_dexterity"), SubResource("Stat_endurance"), SubResource("Stat_will")]
items = [SubResource("Item_blade"), SubResource("Item_dagger"), SubResource("Item_jacket"), SubResource("Item_cloak"), SubResource("Item_boots"), SubResource("Item_ring"), SubResource("Item_potion"), SubResource("Item_ration"), SubResource("Item_ore"), SubResource("Item_herb"), SubResource("Item_letter"), SubResource("Item_map")]
merchant_name = "Странствующий скупщик"
merchant_note = "Тестовая торговля интерфейса. Имя торговца, ассортимент, валюта и цены придуманы только для этой демонстрации."
starting_demo_coins = 60
trade_offers = [SubResource("Offer_cloak"), SubResource("Offer_potion"), SubResource("Offer_amulet"), SubResource("Offer_book")]

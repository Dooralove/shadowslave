[gd_resource type="Resource" script_class="QuestDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_definition.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://scripts/quests/quest_reward.gd" id="3_reward"]

[sub_resource type="Resource" id="Obj_bridge"]
script = ExtResource("2_objective")
id = &"clear_bridge"
text = "Отбить костяной мост у двух карапаксов"
kind = 0
target_id = &"bridge_carapace"
required_count = 2

[sub_resource type="Resource" id="Reward_bridge"]
script = ExtResource("3_reward")
currency_id = &"soul_shard"
currency_amount = 4
text = "4 осколка души"

[resource]
script = ExtResource("1_quest")
id = &"bridge_stand"
scope = &"forgotten_shore"
code = "07"
title = "Костяной мост"
category = 1
summary = "Два карапакса стерегут единственный сухой переход."
description = "Мост узкий, и отступать некуда. Бой можно принять или попробовать проскочить по низкой тропе в отлив."
prerequisites = Array[StringName]([&"shore_bridge_reached"])
required_quests = Array[StringName]([])
auto_start = true
show_available = true
objectives = [SubResource("Obj_bridge")]
rewards = [SubResource("Reward_bridge")]
completion_flag = &"bone_bridge_cleared"

[gd_resource type="Resource" script_class="QuestDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_definition.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://scripts/quests/quest_reward.gd" id="3_reward"]

[sub_resource type="Resource" id="Obj_hunt"]
script = ExtResource("2_objective")
id = &"kill_pack"
text = "Проредить стаю в охотничьих угодьях"
kind = 0
target_id = &"carapace"
required_count = 3

[sub_resource type="Resource" id="Reward_hunt"]
script = ExtResource("3_reward")
currency_id = &"soul_shard"
currency_amount = 6
text = "6 осколков души"

[resource]
script = ExtResource("1_quest")
id = &"hunt_pack"
scope = &"forgotten_shore"
code = "05"
title = "Охота в угодьях"
category = 1
summary = "Карапаксы в центральной равнине не любят чужаков."
description = "Три падальщика патрулируют угодья. Их можно обойти по северному траверсу, но охота даёт осколки и проверяет бой."
prerequisites = Array[StringName]([&"shore_hunting_reached"])
required_quests = Array[StringName]([])
auto_start = true
show_available = true
objectives = [SubResource("Obj_hunt")]
rewards = [SubResource("Reward_hunt")]
completion_flag = &"pack_thinned"

[gd_resource type="Resource" script_class="QuestDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_definition.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://scripts/quests/quest_reward.gd" id="3_reward"]

[sub_resource type="Resource" id="Obj_take"]
script = ExtResource("2_objective")
id = &"take_blade"
text = "Забрать Азурный клинок"
kind = 2
target_id = &"azure_blade"
required_count = 1

[sub_resource type="Resource" id="Reward_blade"]
script = ExtResource("3_reward")
currency_id = &"soul_shard"
currency_amount = 1
memory_id = &"azure_blade"
text = "Память: Азурный клинок"

[resource]
script = ExtResource("1_quest")
id = &"azure_blade"
scope = &"forgotten_shore"
code = "03"
title = "Азурный клинок"
category = 1
summary = "В панцире карапакса осталась чужая Память."
description = "Клинок не лежит в грязи как обычный лут: он отзывается на прикосновение и уходит в Море Души. Это Память, а не предмет полевого набора."
prerequisites = Array[StringName]([&"wounded_scavenger_slain"])
required_quests = Array[StringName]([])
auto_start = true
show_available = true
objectives = [SubResource("Obj_take")]
rewards = [SubResource("Reward_blade")]
completion_flag = &"azure_blade_found"

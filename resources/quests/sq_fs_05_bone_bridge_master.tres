[resource]
script = ExtResource("1_quest")
id = &"sq_fs_05_bone_bridge_master"
scope = &"forgotten_shore"
code = "12"
title = "Хозяин костяного моста"
category = 1
summary = "Под костяным мостом живёт старый карапакс, который использует прилив как оружие."
description = "Старый Панцирь загоняет добычу в канал и ждёт воду. Санни может убить его, устроить приливную ловушку или обойти по мосту. Каждый исход меняет состояние низкой тропы."
prerequisites = Array[StringName]([])
required_quests = Array[StringName]([])
auto_start = false
show_available = false
objectives = [SubResource("Obj_trail"), SubResource("Obj_lair"), SubResource("Obj_resolve"), SubResource("Obj_kill"), SubResource("Obj_tide"), SubResource("Obj_spare"), SubResource("Obj_reward")]
rewards = []
completion_flag = &"sq_fs_05_complete"

[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/slice/slice_director.gd" id="1_director"]
[ext_resource type="Resource" path="res://resources/spell/sunny_status.tres" id="2_status"]
[ext_resource type="PackedScene" path="res://assets/characters/sunny_realistic_poc/sunny_waking_poc.tscn" id="3_sunny"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_runner.gd" id="4_runner"]
[ext_resource type="PackedScene" path="res://scenes/ui/prologue_ui.tscn" id="5_ui"]
